[Unit]
Description=Brain FastAPI server
After=network.target

[Service]
Type=simple
User=ashish
WorkingDirectory=/opt/brain
EnvironmentFile=/opt/brain/.env
ExecStart=/opt/brain/venv/bin/python /opt/brain/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brain-api

[Install]
WantedBy=multi-user.target
