[Unit]
Description=Brain reminder agent — fires reminders for upcoming dated items
After=network.target
OnFailure=brain-scheduler-notify.service

[Service]
Type=oneshot
User=ashish
WorkingDirectory=/opt/brain
EnvironmentFile=/opt/brain/.env
ExecStart=/opt/brain/venv/bin/python /opt/brain/reminder.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brain-reminder
