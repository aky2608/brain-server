[Unit]
Description=Brain weekly section summaries
After=network.target
OnFailure=brain-scheduler-notify.service

[Service]
Type=oneshot
User=ashish
WorkingDirectory=/opt/brain
EnvironmentFile=/opt/brain/.env
ExecStart=/opt/brain/venv/bin/python /opt/brain/weekly_review.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brain-weekly
